{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run dev *)",
      "Bash(npm run extensions)",
      "Bash(npm run db:*)",
      "Bash(npx vitest run *)",
      "Bash(npx eslint *)",
      "Bash(npx tsx scripts/claude/*)",
      "Bash(npx tsx scripts/predict-lane.ts *)",
      "Bash(npx tsx scripts/predict-lane.ts)",
      "Bash(bash .devcontainer/start-preview.sh)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status *)",
      "Bash(gh issue create *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh label create engineering-request *)",
      "Bash(gh api user *)",
      "Bash(gh auth status *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add extensions/*)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git push)",
      "Bash(git pull *)",
      "Bash(git config user.name)",
      "Bash(git config user.email)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Bash(cat .env*)",
      "Bash(cat */.env*)",
      "Bash(printenv *)",
      "Bash(printenv)",
      "Bash(env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * main)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh secret *)",
      "Bash(rm -rf *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-paths.mjs\""
          }
        ]
      }
    ]
  }
}
